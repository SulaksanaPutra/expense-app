{
  "name": "ledgersplit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:status": "supabase migration list --remote",
    "db:push": "supabase db push --remote --yes",
    "db:seed": "supabase db query --remote --yes --file supabase/seed.sql"
  },
  "dependencies": {
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.90.0",
    "lucide-react": "^1.81.0",
    "next": "^16.4.6",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@tailwindcss/postcss": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "eslint": "^9.39.0",
    "eslint-config-next": "^16.4.6",
    "jsdom": "^28.0.0",
    "supabase": "^3.4.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vitest": "^5.1.2"
  }
}
